# /etc/network/interfaces configuration file

# Loopback interface (always needed)
auto lo
iface lo inet loopback

# 10.0.2.15 is the IP address assigned automatically by QEMU to a VM
# when using -nic user. (see: https://www.qemu.org/docs/master/system/devices/net.html)
auto eth0
iface eth0 inet static
    address 10.0.2.15
    netmask 255.255.255.0
    gateway 10.0.2.2
    dns-nameservers 10.0.2.3
